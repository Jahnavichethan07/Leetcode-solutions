{
  "name": "LeetCode Environment",
  "image": "://microsoft.com",
  "customizations": {
    "vscode": {
      "extensions": [
        "LeetCode.vscode-leetcode"
      ],
      "settings": {
        "leetcode.workspaceFolder": "/workspaces/Leetcode-solutions",
        "leetcode.filePath": {
          "default": {
            "folder": "${tag}",
            "filename": "${id}.${kebab-case-name}.${ext}"
          }
        }
      }
    }
  }
}
